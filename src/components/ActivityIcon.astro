---
/* Illustrazioni lineari delle attività in montagna (pagina Montagna).
   Tratto pieno nel verde del sito, campiture leggere per neve e versanti. */
interface Props {
  icon: 'ski' | 'axe' | 'couloir' | 'trek';
}
const { icon } = Astro.props;

const shapes: Record<Props['icon'], string> = {
  // Due sci con attacchi e punte rialzate, bastoncino con rondella, montagna dietro
  ski: `<path class="tint" d="M8 90 L58 28 L94 90 Z" />
    <path d="M12 82 L64 30 C69 25 76 24 80 27" />
    <path d="M22 88 L72 38 C77 33 84 32 88 35" />
    <rect class="solid" x="31" y="50.5" width="14" height="6" rx="1.5" transform="rotate(-45 38 53.5)" />
    <rect class="solid" x="40" y="57.5" width="14" height="6" rx="1.5" transform="rotate(-45 47 60.5)" />
    <path d="M24 24 L76 86" />
    <path class="grip" d="M21.5 21 L27 27.5" />
    <circle class="solid" cx="70.5" cy="79.5" r="5" />
    <path d="M66.5 83 L74.5 76" />`,
  // Piccozza piantata nella neve: becca dentata, paletta, impugnatura
  axe: `<path class="tint" d="M4 94 V82 Q50 64 96 76 V94 Z" />
    <path d="M4 82 Q50 64 96 76" />
    <rect class="solid" x="46" y="24" width="8" height="48" rx="2" />
    <path d="M46 56 H54 M46 61 H54 M46 66 H54" />
    <path class="solid" d="M50 18 C36 18 24 25 15 40 C25 31 37 27 50 27 Z" />
    <path d="M28 30.5 l-1.5 3.5 M34 28.5 l-1.5 3.5 M40 27.5 l-1 3.5" />
    <path class="solid" d="M50 18 H67 C72 18 77 16 82 13 V31 C77 28 72 27 67 27 H50 Z" />
    <circle cx="56" cy="22.5" r="1.8" />`,
  // Parete con un canale di neve e una traccia di passi
  couloir: `<path class="tint" d="M43 92 C46 70 48 48 50 26 C52 48 55 70 59 92 Z" />
    <path d="M4 92 L28 36 L38 44 L50 18 L62 40 L71 32 L96 92" />
    <path d="M43 92 C46 70 48 48 50 26 C52 48 55 70 59 92" />
    <path d="M24 60 l6 -4 M18 73 l7 -5 M31 50 l4 -3 M70 55 l6 4 M76 68 l7 5 M65 47 l4 3" />
    <circle class="dot" cx="51.5" cy="84" r="1.6" />
    <circle class="dot" cx="50" cy="75" r="1.6" />
    <circle class="dot" cx="51.5" cy="66" r="1.6" />
    <circle class="dot" cx="50.3" cy="57" r="1.6" />`,
  // Catena innevata, sentiero tratteggiato e ometto di pietre
  trek: `<path class="tint" d="M4 62 L26 32 L38 44 L56 14 L74 38 L84 28 L96 48 V62 Z" />
    <path d="M4 62 L26 32 L38 44 L56 14 L74 38 L84 28 L96 48" />
    <path d="M49.6 24 L53 28 L56.5 24.5 L60 28.5 L65 26" />
    <path d="M21.5 38 L25 41 L28.5 38.5 L31 40.5" />
    <path d="M4 70 H96" />
    <path d="M26 96 C42 90 62 88 56 81 C51 75 58 73 66 72" stroke-dasharray="3.5 4" />
    <ellipse class="solid" cx="80" cy="88" rx="8" ry="3.8" />
    <ellipse class="solid" cx="80" cy="81" rx="5.8" ry="3.3" />
    <ellipse class="solid" cx="80" cy="75" rx="3.8" ry="2.6" />`,
};
---
<svg class="activity-icon" width="100" height="100" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={shapes[icon]} />

<style>
  .activity-icon {
    display: block;
    color: var(--accent);
  }
  .activity-icon :global(.tint) {
    fill: currentColor;
    fill-opacity: 0.12;
    stroke: none;
  }
  .activity-icon :global(.solid) {
    fill: var(--bg);
  }
  .activity-icon :global(.dot) {
    fill: currentColor;
    stroke: none;
  }
  .activity-icon :global(.grip) {
    stroke-width: 5;
  }
</style>
