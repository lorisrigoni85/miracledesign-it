---
/* Icone lineari delle attività in montagna (pagina Montagna). */
interface Props {
  icon: 'ski' | 'axe' | 'couloir' | 'trek';
}
const { icon } = Astro.props;

const shapes: Record<Props['icon'], string> = {
  // Due sci con le punte rialzate e un bastoncino
  ski: `<path d="M6 36 L31 11 C33.5 8.5 37 8 39 9.5" />
    <path d="M11 41 L36 16 C38.5 13.5 42 13 44 14.5" />
    <path d="M12 8 L38 42" />
    <circle cx="34.6" cy="37.6" r="2.6" />`,
  // Piccozza
  axe: `<path d="M7 21 C11 14.5 17 11 24 11 H36" />
    <path d="M24 14.5 H29" />
    <path d="M36 8 V14" />
    <path d="M24 11 V40" />
    <path d="M22 40 L24 45 L26 40 Z" />`,
  // Montagna con un canale di neve al centro
  couloir: `<path d="M3 42 L17 10 L24 17 L31 8 L45 42" />
    <path d="M20.5 42 C22.5 33 23 25 24 17 C25 25 25.5 33 27.5 42" />`,
  // Montagne lontane e sentiero tratteggiato
  trek: `<path d="M3 30 L15 16 L21 22 L30 9 L45 30" />
    <path d="M25.5 15.5 L28 17.5 L30 15.5 L32.5 17.5 L34.5 15.6" />
    <path d="M12 45 C22 43 32 40.5 27 37 C23 34.5 24 32.5 29 31" stroke-dasharray="2.5 3" />`,
};
---
<svg class="activity-icon" width="40" height="40" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={shapes[icon]} />

<style>
  .activity-icon {
    display: block;
    color: var(--accent);
  }
</style>
