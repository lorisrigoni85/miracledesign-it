---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NextStep from '../NextStep.astro';
import { routes, type Lang } from '../../i18n/ui';
import { archive, countryName } from '../../data/archive';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const entry = (await getEntry('pages', `${lang}/archive`))!;
const head = lang === 'it' ? { client: 'Cliente', year: 'Anno', country: 'Paese', type: 'Tipo' } : { client: 'Client', year: 'Year', country: 'Country', type: 'Type' };
---
<BaseLayout lang={lang} title={`${entry.data.title} — Loris Rigoni | Miracle Design`} description={entry.data.description} alternates={routes.archive}>
  <div class="container">
    <header class="page-head">
      <h1 class="page-title">{entry.data.title}</h1>
      <p class="page-lead">{entry.data.lead}</p>
    </header>

    <table class="archive">
      <caption class="visually-hidden">{entry.data.title}</caption>
      <thead>
        <tr><th scope="col">{head.client}</th><th scope="col">{head.year}</th><th scope="col">{head.country}</th><th scope="col">{head.type}</th></tr>
      </thead>
      <tbody>
        {archive.map((item) => (
          <tr>
            <th scope="row">{item.client}</th>
            <td class="mono">{item.year}</td>
            <td class="archive__country">{item.country ? countryName[item.country][lang] : ''}</td>
            <td class="archive__type">{item.type[lang]}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <NextStep lang={lang} page="archive" />
  </div>
</BaseLayout>

<style>
  .archive {
    width: 100%;
    margin-bottom: 64px;
    border-collapse: collapse;
    border-top: 1px solid var(--rule-strong);
  }
  .archive th,
  .archive td {
    padding: 16px 16px 16px 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: baseline;
  }
  .archive thead th {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .archive tbody th {
    font-weight: 500;
  }
  .archive__country,
  .archive__type {
    color: var(--ink-body);
  }
  @media (max-width: 600px) {
    /* Telefono: nome e anno sulla prima riga, paese e tipo sulla seconda */
    .archive thead {
      display: none;
    }
    .archive tr {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 2px 0;
      padding: 14px 0;
      border-bottom: 1px solid var(--rule);
    }
    .archive th,
    .archive td {
      padding: 0;
      border: 0;
    }
    .archive tbody th {
      flex: 1 0 calc(100% - 64px);
      padding-right: 16px;
    }
    .archive__country,
    .archive__type {
      font-size: 15px;
    }
    .archive__country:not(:empty)::after {
      content: '·';
      margin-inline: 8px;
    }
  }
</style>
