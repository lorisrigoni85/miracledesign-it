---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui, routes, type Lang } from '../../i18n/ui';
import { getChapters, getTwin, chapterUrl, chapterLang, type Chapter } from '../../i18n/chapters';

interface Props {
  entry: Chapter;
}
const { entry } = Astro.props;
const lang: Lang = chapterLang(entry);
const t = ui[lang];
const { Content } = await render(entry);

const list = await getChapters(lang);
const index = list.findIndex((c) => c.id === entry.id);
const prev = list[index - 1];
const next = list[index + 1];

const twin = await getTwin(entry);
const here = chapterUrl(entry);
const alternates = {
  [lang]: here,
  [lang === 'it' ? 'en' : 'it']: twin ? chapterUrl(twin) : routes.telepass[lang === 'it' ? 'en' : 'it'],
} as Record<Lang, string>;
---
<BaseLayout lang={lang} title={`${entry.data.title} — Telepass | Loris Rigoni`} description={entry.data.description} alternates={alternates}>
  <article class="container">
    <header class="page-head">
      <nav class="breadcrumb label" aria-label="Breadcrumb">
        <ol>
          <li><a href={t.workAnchor}>{t.work}</a></li>
          <li><a href={routes.telepass[lang]}>Telepass</a></li>
          <li><span aria-current="page">{entry.data.title}</span></li>
        </ol>
      </nav>
      <p class="mono">{t.chapter} {entry.data.order} · {entry.data.year}</p>
      <h1 class="page-title">{entry.data.title}</h1>
      <dl class="meta summary" aria-label={t.summary}>
        {entry.data.summary.map((s) => (
          <div><dt>{s.term}</dt><dd>{s.value}</dd></div>
        ))}
      </dl>
    </header>

    <div class="prose chapter-body">
      <Content />
    </div>

    <nav class="pager" aria-label={t.chapters}>
      <div class="pager__side">
        {prev && (
          <a href={chapterUrl(prev)} rel="prev">
            <span class="label">← {t.prevChapter}</span>
            <span class="pager__title">{prev.data.title}</span>
          </a>
        )}
      </div>
      <div class="pager__side pager__side--next">
        {next && (
          <a href={chapterUrl(next)} rel="next">
            <span class="label">{t.nextChapter} →</span>
            <span class="pager__title">{next.data.title}</span>
          </a>
        )}
      </div>
      <a class="link pager__back" href={routes.telepass[lang]}>{t.backToIndex}</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .summary {
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
  .chapter-body {
    padding-bottom: 32px;
  }
  .chapter-body > :global(.placeholder:first-child) {
    margin-top: 0;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 48px;
    padding-top: 32px;
    padding-bottom: var(--section-y);
    border-top: 1px solid var(--rule-strong);
    margin-top: 48px;
  }
  .pager__side a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: var(--tap);
    text-decoration: none;
  }
  .pager__side--next {
    text-align: right;
  }
  .pager__title {
    font-size: var(--fs-row);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .pager__side a:hover .pager__title {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }
  .pager__back {
    grid-column: 1 / -1;
    justify-self: start;
  }
  @media (max-width: 600px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager__side--next {
      text-align: left;
    }
  }
</style>
