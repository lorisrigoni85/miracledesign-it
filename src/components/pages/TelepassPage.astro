---
/* Pagina Telepass: apertura, tre posizioni e i quattro momenti (Story.astro). */
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NextStep from '../NextStep.astro';
import Story from '../Story.astro';
import TelepassDiagram from '../TelepassDiagram.astro';
import DeviceMockup from '../DeviceMockup.astro';
import { emphasis } from '../../utils/emphasis';
import { ui, routes, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const resourceImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/telepass/*.jpg', { eager: true });
const resourceImage = (name: string) => {
  const entry = Object.entries(resourceImages).find(([path]) => path.endsWith(`/${name}.jpg`));
  if (!entry) throw new Error(`Immagine non trovata: src/assets/telepass/${name}.jpg`);
  return entry[1].default;
};
const page = (await getEntry('telepass', lang))!.data;
---
<BaseLayout lang={lang} title={page.meta.title} description={page.meta.description} alternates={routes.telepass}>
  <div class="container">
    <header class="page-head">
      <nav class="breadcrumb label" aria-label="Breadcrumb">
        <ol>
          <li><a href={routes.work[lang]}>{t.work}</a></li>
          <li><span aria-current="page">Telepass</span></li>
        </ol>
      </nav>
      <p class="mono">{page.name}</p>
      <h1 class="page-title">{page.title}</h1>
      <p class="page-lead">{page.lead}</p>
    </header>

    <DeviceMockup alt={page.mockupAlt} />

    <ul class="positions">
      {page.positions.map((p) => (
        <li><span class="mono">{p.period}</span><strong>{p.name}</strong><span>{p.text}</span></li>
      ))}
    </ul>
  </div>

  <!-- I quattro momenti: indice che segue lo scorrimento e racconto -->
  <Story label={page.navLabel} moments={page.moments}>
    {page.moments.map((m, i) => (
      <article id={m.id} class="moment" data-moment aria-labelledby={`${m.id}-title`}>
        <p class="moment__year" aria-hidden="true">{m.year}</p>
        <p class="label">{String(i + 1).padStart(2, '0')} · {m.where}</p>
        <h2 id={`${m.id}-title`} class="moment__title">{m.title}</h2>
        <div class="moment__text">
          {m.text.map((p) => <p set:html={emphasis(p)} />)}
          {m.link && !m.link.image && (
            <p class="moment__link">
              <a class="link" href={m.link.url} target="_blank" rel="noopener">{m.link.label} <span aria-hidden="true">↗</span><span class="visually-hidden"> {lang === 'it' ? '(si apre in una nuova scheda)' : '(opens in a new tab)'}</span></a>
            </p>
          )}
        </div>
        <blockquote class="moment__principle"><p>{m.principle}</p></blockquote>
        <TelepassDiagram kind={m.diagram} labels={page.diagrams} />
        {m.link?.image && (
          <aside class="resource">
            <a class="resource__media" href={m.link.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
              <Image src={resourceImage(m.link.image)} alt="" widths={[400, 800]} sizes="(max-width: 760px) 100vw, 340px" />
            </a>
            <div class="resource__text">
              {m.link.text && <p set:html={emphasis(m.link.text)} />}
              <a class="link" href={m.link.url} target="_blank" rel="noopener">{m.link.label}<span class="ext" aria-hidden="true">↗</span><span class="visually-hidden"> {lang === 'it' ? '(si apre in una nuova scheda)' : '(opens in a new tab)'}</span></a>
            </div>
          </aside>
        )}
      </article>
    ))}
  </Story>

  <div class="container">
    <NextStep lang={lang} page="telepass" />
  </div>
</BaseLayout>

<style>
  .positions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 32px;
    margin: 64px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule-strong);
  }
  .positions li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 20px;
  }
  .positions strong {
    font-size: var(--fs-row);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .positions li > span:last-child {
    color: var(--ink-body);
  }

  .moment__link {
    margin-top: 8px;
  }
  .moment__link [aria-hidden='true'] {
    margin-left: 0.25em;
  }
  /* Scheda risorsa esterna (es. design system su zeroheight) */
  .resource {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px 32px;
    max-width: 760px;
    margin-top: 24px;
    padding: 24px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-media);
  }
  .resource .ext {
    margin-left: 0.25em;
  }
  .resource__media {
    flex: 1 1 240px;
    max-width: 340px;
    overflow: hidden;
    border-radius: 4px;
  }
  .resource__media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 300ms ease;
  }
  .resource__media:hover :global(img) {
    transform: scale(1.03);
  }
  .resource__text {
    flex: 1.2 1 260px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    color: var(--ink-body);
  }
  @media (max-width: 900px) {
    .positions {
      grid-template-columns: 1fr;
    }
  }
</style>
