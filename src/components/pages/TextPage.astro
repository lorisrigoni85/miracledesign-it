---
/* Pagine di testo semplici: Chi sono, Privacy. */
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import ritratto from '../../assets/foto/ritratto-chiaro.jpg';
import NextStep from '../NextStep.astro';
import type { ImageMetadata } from 'astro';
import { ui, routes, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  page: 'about' | 'privacy';
}
const { lang, page } = Astro.props;
const t = ui[lang];
const entry = (await getEntry('pages', `${lang}/${page}`))!;
const { Content } = await render(entry);
const isAbout = page === 'about';

// Anteprima della pagina Montagna (solo in Chi sono).
const mountains = isAbout ? (await getEntry('mountains', lang))!.data : null;
const mountainPhotos = import.meta.glob<{ default: ImageMetadata }>('../../assets/montagna/*.jpg', { eager: true });
const teaserPhoto = mountains
  ? Object.entries(mountainPhotos).find(([path]) => path.endsWith(`/${mountains.teaser.photo}.jpg`))?.[1].default
  : undefined;
const teaserAlt = mountains?.photos.find((p) => p.file === mountains.teaser.photo)?.alt ?? '';
const label = isAbout ? t.nav.about : t.privacy;
---
<BaseLayout lang={lang} title={`${label} — Loris Rigoni | Miracle Design`} description={entry.data.description} alternates={routes[page]}>
  <div class="container">
    <header class:list={['page-head', isAbout && 'about-head']}>
      <div class="about-head__text">
        <p class="label">{label}</p>
        <h1 class="page-title">{entry.data.title}</h1>
        {entry.data.lead && <p class="page-lead">{entry.data.lead}</p>}
      </div>
      {isAbout && (
        <div class="about-head__media">
          <Image src={ritratto} alt={lang === 'it' ? 'Ritratto di Loris Rigoni' : 'Portrait of Loris Rigoni'} class="portrait" widths={[400, 763]} sizes="(max-width: 760px) 100vw, 400px" loading="eager" />
        </div>
      )}
    </header>

    <div class="prose page-body">
      <Content />
    </div>

    {mountains && (
      <section class="mountains" aria-labelledby="mountains-title">
        {teaserPhoto && (
          <a href={routes.mountains[lang]} class="mountains__media" tabindex="-1" aria-hidden="true">
            <Image src={teaserPhoto} alt="" widths={[480, 960]} sizes="(max-width: 760px) 100vw, 480px" />
          </a>
        )}
        <div class="mountains__text">
          <p class="label">{mountains.label}</p>
          <h2 id="mountains-title" class="mountains__title">{mountains.title}</h2>
          <p>{mountains.teaser.text}</p>
          <a class="btn btn--solid" href={routes.mountains[lang]}>{mountains.teaser.link} →</a>
        </div>
      </section>
    )}

    {isAbout && <NextStep lang={lang} page="about" />}
  </div>
</BaseLayout>

<style>
  .about-head {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px 80px;
  }
  .about-head__text {
    flex: 1.4 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .about-head__media {
    flex: 1 1 280px;
    max-width: 400px;
  }
  .portrait {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: var(--radius-media);
  }
  .page-body {
    padding-bottom: 48px;
  }
  /* Anteprima Montagna: foto e testo affiancati, centrati in verticale */
  .mountains {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px 64px;
    margin-bottom: 64px;
    padding: 40px 0;
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule);
  }
  .mountains__media {
    flex: 1 1 280px;
    max-width: 440px;
    border-radius: var(--radius-media);
    overflow: hidden;
  }
  .mountains__media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 40%;
  }
  .mountains__text {
    flex: 1.3 1 360px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    color: var(--ink-body);
  }
  .mountains__title {
    font-size: var(--fs-h2-about);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--ink);
  }
  .page-body > :global(h2:first-child) {
    margin-top: 0;
  }
  .page-body:last-child {
    padding-bottom: var(--section-y);
  }
</style>
