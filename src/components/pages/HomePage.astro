---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import heroPhoto from '../../assets/foto/hero-ritratto.jpg';
import ritratto from '../../assets/foto/ritratto-chiaro.jpg';
import BaseLayout from '../../layouts/BaseLayout.astro';
import telepassMockup from '../../assets/foto/telepass-mockup.png';
import { ui, routes, type Lang } from '../../i18n/ui';
import { archive } from '../../data/archive';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const home = (await getEntry('home', lang))!.data;
// I quattro momenti Telepass, dal più recente come il Percorso; ognuno porta al suo punto della pagina Telepass.
const telepass = (await getEntry('telepass', lang))!.data;
const moments = [...telepass.moments].reverse();
const preview = archive.filter((item) => item.preview);
---
<BaseLayout lang={lang} title={home.meta.title} description={home.meta.description} alternates={routes.home} person darkHero>
  <!-- 1. Apertura: foto a tutta pagina, testo a sinistra -->
  <section class="hero" aria-labelledby="hero-title">
    <Image
      src={heroPhoto}
      alt={home.hero.imageAlt}
      class="hero__photo"
      widths={[800, 1200, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="container hero__content">
      <p class="label hero__label">
        <span class="hero__dot" aria-hidden="true"></span>
        {home.hero.label}
      </p>
      <h1 id="hero-title" class="hero__name">{home.hero.name}</h1>
      <p class="hero__claim">{home.hero.claim}</p>
      <p class="hero__subtitle">{home.hero.subtitle}</p>
      <div class="actions">
        <a class="btn hero__btn" href={`#${home.work.anchor}`}>{home.hero.primary}</a>
        <a class="link hero__link" href={t.contactAnchor}>{home.hero.secondary}</a>
      </div>
    </div>
  </section>

  <!-- 2. Lavori in evidenza -->
  <section id={home.work.anchor} class="container work" aria-labelledby="work-title">
    <h2 id="work-title" class="section-head"><span>{home.work.label}</span></h2>

    <article class="case">
      <div class="case__text">
        <p class="mono">{home.work.telepass.eyebrow}</p>
        <h3 class="case__title">{home.work.telepass.title}</h3>
        <p class="case__body">{home.work.telepass.text}</p>
        <ul class="case__stats">
          {home.work.telepass.stats.map((stat) => <li>{stat}</li>)}
        </ul>
        <a class="link" href={routes.telepass[lang]}>{t.readCase} →</a>
      </div>
      <div class="case__media">
        <Image src={telepassMockup} alt={home.work.telepass.image} class="case__img" widths={[600, 900, 1200]} sizes="(max-width: 760px) 100vw, 640px" />
      </div>
    </article>

    <ol class="rows chapters" aria-label={`Telepass — ${telepass.navLabel}`}>
      {moments.map((m) => (
        <li>
          <a href={`${routes.telepass[lang]}#${m.id}`} class="chapters__row">
            <span class="mono">{m.year}</span>
            <span class="chapters__title">{m.title}</span>
            <span class="chapters__teaser">{m.principle}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- 3. Percorso -->
  <section class="container section" aria-labelledby="path-title">
    <h2 id="path-title" class="section-head"><span>{home.path.label}</span></h2>
    <ol class="rows path">
      {home.path.rows.map((row) => (
        <li class="path__row">
          <span class="mono path__period">{row.period}</span>
          <span class="path__company">{row.company}</span>
          <span class="path__text">{row.text}</span>
        </li>
      ))}
    </ol>
  </section>

  <!-- 4. Chi sono (anteprima) -->
  <section class="band" aria-labelledby="about-title">
    <div class="container section about">
      <div class="about__media">
        <Image src={ritratto} alt={home.about.image} class="about__photo" widths={[440, 763]} sizes="(max-width: 760px) 100vw, 440px" />
      </div>
      <div class="about__text">
        <p class="label">{home.about.label}</p>
        <h2 id="about-title" class="about__title">{home.about.title}</h2>
        {home.about.text.map((p) => <p class="about__p">{p}</p>)}
        <div class="actions">
          <a class="btn btn--solid" href={routes.about[lang]}>{home.about.button}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Archivio (anteprima) -->
  <section class="container section" aria-labelledby="archive-title">
    <h2 id="archive-title" class="section-head"><span>{home.archive.label}</span></h2>
    <ul class="archive-grid">
      {preview.map((item) => (
        <li><span>{item.client}</span><span class="mono">{item.year}</span></li>
      ))}
    </ul>
    <div class="actions archive-actions">
      <a class="btn btn--outline" href={routes.archive[lang]}>{home.archive.link}</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Apertura: sotto l'header trasparente, alta quanto lo schermo */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    margin-top: calc(-1 * var(--header-h));
    padding-top: var(--header-h);
    background: var(--ink);
    color: var(--on-dark);
    overflow: hidden;
  }
  .hero::after {
    /* Velatura a sinistra per leggere il testo sopra le montagne */
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(21, 24, 26, 0.45) 0%, rgba(21, 24, 26, 0.18) 36%, rgba(21, 24, 26, 0) 52%);
  }
  .hero__photo {
    position: absolute;
    top: 0;
    right: 0;
    width: 72%;
    height: 100%;
    object-fit: cover;
    /* Figura spostata di 100px verso il testo */
    object-position: calc(70% - 100px) 30%;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 30%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 30%);
  }
  .hero__content {
    position: relative;
    z-index: 1;
    /* Ombra leggera: il testo resta leggibile anche dove la velatura è più tenue */
    text-shadow: 0 1px 14px rgba(21, 24, 26, 0.35);
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding-block: 64px 96px;
  }
  .hero__label {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--on-dark-muted);
  }
  /* Led acceso: centro chiaro, alone verde e un respiro lento */
  .hero__dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #e9fff3 0 18%, #6ff0a8 45%, #23b26b 100%);
    box-shadow:
      0 0 4px 1px rgba(111, 240, 168, 0.85),
      0 0 14px 3px rgba(60, 210, 130, 0.45);
    animation: led-breath 2.8s ease-in-out infinite;
  }
  @keyframes led-breath {
    0%,
    100% {
      box-shadow:
        0 0 4px 1px rgba(111, 240, 168, 0.85),
        0 0 14px 3px rgba(60, 210, 130, 0.45);
    }
    50% {
      box-shadow:
        0 0 3px 1px rgba(111, 240, 168, 0.6),
        0 0 8px 1px rgba(60, 210, 130, 0.25);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__dot {
      animation: none;
    }
  }
  .hero__name {
    font-size: clamp(52px, 7.5vw, 112px);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .hero__claim {
    max-width: 540px;
    font-size: clamp(20px, 1.9vw, 26px);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .hero__subtitle {
    max-width: 500px;
    font-size: 16px;
    color: var(--on-dark-muted);
  }
  .hero .actions {
    margin-top: 12px;
  }
  .hero__btn {
    padding: 14px 26px;
    background: var(--on-dark);
    color: var(--ink);
  }
  .hero__btn:hover {
    background: transparent;
    color: var(--on-dark);
    box-shadow: inset 0 0 0 1px var(--on-dark);
  }
  .hero__link {
    color: var(--on-dark);
  }
  .hero__link:hover {
    color: var(--on-dark-muted);
  }
  .hero :focus-visible {
    outline-color: var(--on-dark);
  }
  @media (min-width: 761px) and (max-width: 1200px) {
    /* Schermi medi: testo più stretto, figura più a destra per non coprire il viso */
    .hero__photo {
      object-position: 92% 30%;
    }
    .hero__claim,
    .hero__subtitle {
      max-width: 400px;
    }
  }
  @media (max-width: 760px) {
    /* Telefono: foto in alto, testo in basso su fondo scuro */
    .hero {
      align-items: flex-end;
    }
    .hero::after {
      background: linear-gradient(180deg, rgba(21, 24, 26, 0) 25%, rgba(21, 24, 26, 0.85) 58%, var(--ink) 75%);
    }
    .hero__photo {
      width: 100%;
      height: 70%;
      object-position: 80% 20%;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .hero__content {
      padding-block: 0 48px;
    }
  }

  /* Spazio sopra la linea di sezione: senza, la linea scura toccava il bordo della foto */
  .work {
    padding-top: var(--section-y);
    padding-bottom: 32px;
  }
  .case {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px 64px;
    padding: 56px 0 64px;
    border-top: 1px solid var(--rule);
  }
  .case__text {
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .case__media {
    flex: 1.3 1 440px;
    min-width: 0;
  }
  .case__img {
    width: 100%;
    height: auto;
  }
  .case__title {
    font-size: var(--fs-h2-case);
    font-weight: 500;
    line-height: var(--lh-h2-case);
    letter-spacing: -0.025em;
  }
  .case__body {
    color: var(--ink-body);
  }
  .case__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 0.6em;
    list-style: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .case__stats li:not(:last-child)::after {
    content: ',';
  }

  .chapters__row {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 4px 32px;
    align-items: baseline;
    padding: 20px 0;
    text-decoration: none;
  }
  .chapters__title {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .chapters__teaser {
    color: var(--ink-body);
  }
  .chapters__row:hover .chapters__title {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }
  @media (max-width: 760px) {
    .chapters__row {
      grid-template-columns: 1fr;
    }
  }

  .path__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 32px;
    padding: 24px 0;
  }
  .path__period {
    flex: 0 0 160px;
    font-size: 15px;
  }
  .path__company {
    flex: 1 1 240px;
    font-size: var(--fs-row);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .path__text {
    flex: 2 1 320px;
    color: var(--ink-body);
  }

  .band {
    background: var(--bg-band);
  }
  /* Immagine e testo affiancati: centrati in verticale */
  .about {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px 80px;
  }
  .about__media {
    flex: 1 1 320px;
    max-width: 440px;
  }
  .about__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: var(--radius-media);
  }
  .about__text {
    flex: 1.4 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .about__text .label {
    color: var(--ink);
  }
  .about__title {
    font-size: var(--fs-h2-about);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }
  .about__p {
    max-width: 600px;
    color: var(--ink-body);
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0 48px;
    list-style: none;
    padding: 0;
  }
  .archive-actions {
    margin-top: 40px;
  }
  .archive-grid li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-top: 1px solid var(--rule);
  }
</style>
