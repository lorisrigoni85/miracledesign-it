---
/*
 * Logo Miracle Design, ricostruito in vettoriale (src/assets/brand/README.md).
 * Prende il colore del testo in cui è inserito. Larghezza minima 200px: sotto, "DESIGN" diventa illeggibile.
 */
import LogoSvg from '../assets/brand/miracle-design-logo-currentcolor.svg';

interface Props {
  /** Larghezza in px, minimo 200. */
  width?: number;
}
const { width = 200 } = Astro.props;
---
<LogoSvg class="logo" width={width} height={Math.round((width * 214) / 750)} style={`width:${width}px`} aria-hidden="true" focusable="false" />

<style>
  .logo {
    display: block;
    max-width: 100%;
    height: auto;
    color: currentColor;
  }
</style>
