---
/*
 * Illustrazione della pagina 404, stile "clay" in colori pastello, senza fondo:
 * un'isola sospesa con tre montagne innevate, colline, abeti, sole e nuvole.
 * Il sentiero sale sulla montagna principale e si interrompe davanti a una frattura; accanto, il cartello 404.
 * I volumi sono resi con sfumature e ombre morbide (finto 3D).
 */
const tree = 'M-15 0 Q-14 -12 0 -48 Q14 -12 15 0 Q0 7 -15 0 Z';
const trees = [
  { x: 132, y: 372, s: 0.9 },
  { x: 162, y: 382, s: 0.7 },
  { x: 318, y: 384, s: 0.85 },
  { x: 346, y: 376, s: 0.65 },
  { x: 404, y: 366, s: 0.8 },
];
const rays = Array.from({ length: 8 }, (_, i) => i * 45);
---
<svg class="island" viewBox="0 0 520 490" aria-hidden="true">
  <defs>
    <linearGradient id="mi-grass" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#d7ecc4" />
      <stop offset="1" stop-color="#bddca6" />
    </linearGradient>
    <linearGradient id="mi-grass-edge" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#a9cf92" />
      <stop offset="0.5" stop-color="#b9d9a3" />
      <stop offset="1" stop-color="#9fc888" />
    </linearGradient>
    <linearGradient id="mi-earth" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#d9b59a" />
      <stop offset="0.5" stop-color="#e6c6ad" />
      <stop offset="1" stop-color="#cfa98d" />
    </linearGradient>
    <linearGradient id="mi-mount" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#a7d6cc" />
      <stop offset="1" stop-color="#86c1b4" />
    </linearGradient>
    <linearGradient id="mi-mount-shade" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#7fb7aa" />
      <stop offset="1" stop-color="#6aa697" />
    </linearGradient>
    <linearGradient id="mi-hill" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#cdeee3" />
      <stop offset="1" stop-color="#aedfcf" />
    </linearGradient>
    <linearGradient id="mi-snow" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="1" stop-color="#eef0f2" />
    </linearGradient>
    <radialGradient id="mi-sun" cx="0.4" cy="0.35" r="0.7">
      <stop offset="0" stop-color="#ffe7a8" />
      <stop offset="1" stop-color="#f6cf7c" />
    </radialGradient>
    <linearGradient id="mi-tree" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#a8d39a" />
      <stop offset="1" stop-color="#86bd7c" />
    </linearGradient>
    <linearGradient id="mi-wood" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ecd0b0" />
      <stop offset="1" stop-color="#ddb995" />
    </linearGradient>
    <filter id="mi-soft" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="4" flood-color="#2f3a36" flood-opacity="0.14" />
    </filter>
    <filter id="mi-blur" x="-30%" y="-150%" width="160%" height="400%"><feGaussianBlur stdDeviation="10" /></filter>
  </defs>

  <!-- ombra sotto l'isola -->
  <ellipse cx="260" cy="438" rx="170" ry="16" fill="#2f3a36" opacity="0.12" filter="url(#mi-blur)" />

  <!-- isola: terra, bordo d'erba, prato -->
  <path d="M40 360 A220 54 0 0 0 480 360 L480 390 A220 54 0 0 1 40 390 Z" fill="url(#mi-earth)" />
  <path d="M40 360 A220 54 0 0 0 480 360 L480 372 A220 54 0 0 1 40 372 Z" fill="url(#mi-grass-edge)" />
  <ellipse cx="260" cy="360" rx="220" ry="54" fill="url(#mi-grass)" />

  <!-- sole e raggi -->
  <g transform="translate(340 72)">
    {rays.map((deg) => (
      <rect x="-4" y="-44" width="8" height="16" rx="4" fill="#f6cf7c" transform={`rotate(${deg})`} />
    ))}
    <circle r="22" fill="url(#mi-sun)" filter="url(#mi-soft)" />
  </g>

  <!-- montagne -->
  <g filter="url(#mi-soft)">
    <!-- sinistra -->
    <path d="M72 352 L140 200 Q150 182 160 200 L232 352 Z" fill="url(#mi-mount)" />
    <path d="M150 196 L232 352 L152 352 Z" fill="url(#mi-mount-shade)" opacity="0.55" />
    <path d="M124 236 L140 200 Q150 182 160 200 L177 236 Q170 230 163 238 Q156 246 150 238 Q143 229 136 240 Q130 246 124 236 Z" fill="url(#mi-snow)" />
    <!-- destra -->
    <path d="M288 354 L360 184 Q370 165 380 184 L456 354 Z" fill="url(#mi-mount)" />
    <path d="M370 180 L456 354 L372 354 Z" fill="url(#mi-mount-shade)" opacity="0.55" />
    <path d="M343 224 L360 184 Q370 165 380 184 L398 224 Q391 217 384 226 Q377 234 370 226 Q363 217 356 228 Q349 234 343 224 Z" fill="url(#mi-snow)" />
    <!-- principale -->
    <path d="M152 358 L248 130 Q260 106 272 130 L372 358 Z" fill="url(#mi-mount)" />
    <path d="M260 124 L372 358 L262 358 Z" fill="url(#mi-mount-shade)" opacity="0.55" />
    <path d="M229 176 L248 130 Q260 106 272 130 L292 176 Q284 168 276 178 Q268 188 260 178 Q252 168 244 179 Q236 186 229 176 Z" fill="url(#mi-snow)" />
  </g>

  <!-- sentiero sulla montagna principale: sale e si interrompe alla frattura -->
  <path d="M206 352 C 226 334, 200 318, 226 302 S 262 286, 244 268 S 262 250, 266 246" fill="none" stroke="#ffffff" stroke-width="4" stroke-linecap="round" stroke-dasharray="2 9" opacity="0.95" />
  <path d="M276 236 L285 256 L277 276 L288 300 L281 322" fill="none" stroke="#5e9a8c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M296 270 C 306 262, 312 252, 306 240 S 312 222, 318 214" fill="none" stroke="#ffffff" stroke-width="4" stroke-linecap="round" stroke-dasharray="2 9" opacity="0.5" />

  <!-- cartello 404 -->
  <g filter="url(#mi-soft)">
    <rect x="244" y="212" width="6" height="40" rx="3" fill="#cfa98d" />
    <rect x="222" y="196" width="50" height="26" rx="6" fill="url(#mi-wood)" />
    <text x="247" y="214" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="13" font-weight="600" fill="#5b4a3c">404</text>
  </g>
  <!-- sei qui -->
  <circle cx="266" cy="246" r="6" fill="#3f6b5a" />

  <!-- colline -->
  <g filter="url(#mi-soft)">
    <path d="M118 372 Q182 286 252 372 Q186 384 118 372 Z" fill="url(#mi-hill)" />
    <path d="M262 374 Q330 300 402 374 Q332 386 262 374 Z" fill="url(#mi-hill)" />
  </g>

  <!-- abeti -->
  {trees.map((t) => (
    <g transform={`translate(${t.x} ${t.y}) scale(${t.s})`} filter="url(#mi-soft)">
      <rect x="-3" y="-4" width="6" height="12" rx="3" fill="#c79f82" />
      <path d={tree} fill="url(#mi-tree)" />
    </g>
  ))}

  <!-- nuvole -->
  <g filter="url(#mi-soft)" fill="#ffffff">
    <g transform="translate(150 118)">
      <circle cx="0" cy="0" r="16" /><circle cx="20" cy="-10" r="20" /><circle cx="42" cy="0" r="15" />
      <rect x="-12" y="-2" width="66" height="17" rx="8.5" />
    </g>
    <g transform="translate(372 96)">
      <circle cx="0" cy="0" r="13" /><circle cx="17" cy="-8" r="17" /><circle cx="35" cy="0" r="12" />
      <rect x="-10" y="-2" width="55" height="14" rx="7" />
    </g>
  </g>
</svg>

<style>
  .island {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
