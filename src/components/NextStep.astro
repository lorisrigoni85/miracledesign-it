---
/* Chiusura delle pagine di secondo livello: pulsante contestuale per continuare l'esplorazione dalla Home. */
import { ui, routes, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  page: 'archive' | 'about' | 'telepass';
}
const { lang, page } = Astro.props;
const t = ui[lang];
// Archivio e Chi sono portano ai lavori in evidenza; Telepass all'inizio della Home.
const href = page === 'telepass' ? routes.home[lang] : t.workAnchor;
---
<div class="next">
  <a class="btn btn--outline next__btn" href={href}>
    {t.next[page]}
    <span class="next__arrow" aria-hidden="true">→</span>
  </a>
</div>

<style>
  .next {
    padding-bottom: var(--section-y);
  }
  .next__btn {
    gap: 10px;
  }
  .next__arrow {
    transition: transform var(--transition);
  }
  .next__btn:hover .next__arrow {
    transform: translateX(4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .next__btn:hover .next__arrow {
      transform: none;
    }
  }
</style>
