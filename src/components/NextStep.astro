---
/* Chiusura delle pagine di secondo livello: pulsante contestuale per continuare l'esplorazione dalla Home. */
import { ui, routes, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  page: 'archive' | 'about' | 'telepass' | 'cv' | 'mountains';
}
const { lang, page } = Astro.props;
const t = ui[lang];
// Archivio, Chi sono e CV portano ai lavori in evidenza; Telepass all'inizio della Home; Montagna a Chi sono.
const href = page === 'telepass' ? routes.home[lang] : page === 'mountains' ? routes.about[lang] : t.workAnchor;
---
<div class="next">
  <!-- Azioni in più prima del pulsante (es. Scarica il CV) -->
  <slot />
  <a class="btn btn--outline next__btn" href={href}>
    {t.next[page]}
    <span class="next__arrow" aria-hidden="true">→</span>
  </a>
</div>

<style>
  /* A destra su computer, centrato su telefono */
  .next {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 12px 16px;
    padding-bottom: var(--section-y);
  }
  .next__btn {
    gap: 10px;
  }
  .next__arrow {
    transition: transform var(--transition);
  }
  .next__btn:hover .next__arrow {
    transform: translateX(4px);
  }
  @media (max-width: 600px) {
    .next {
      justify-content: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .next__btn:hover .next__arrow {
      transform: none;
    }
  }
</style>
