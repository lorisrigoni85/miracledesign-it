---
/*
 * Mockup di telepass.com su computer e telefono, disegnato in CSS.
 * Dentro gli schermi ruotano le quattro slide del carosello della home (schermate di ottobre 2026),
 * sincronizzate tra i due dispositivi. Con "riduci movimento" resta ferma la prima slide.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  alt: string;
}
const { alt } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/telepass/*.jpg', { eager: true });
const pick = (prefix: string) =>
  Object.entries(files)
    .filter(([path]) => path.includes(`/${prefix}-`))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, mod]) => mod.default);
const desktop = pick('desktop');
const mobile = pick('mobile');
---
<div class="devices" role="img" aria-label={alt} data-devices>
  <div class="laptop">
    <div class="laptop__lid">
      <div class="laptop__screen">
        {desktop.map((src, i) => (
          <Image src={src} alt="" class:list={['slide', i === 0 && 'is-active']} widths={[720, 1080, 1440]} sizes="(max-width: 1064px) 78vw, 780px" loading={i === 0 ? 'eager' : 'lazy'} />
        ))}
      </div>
    </div>
    <div class="laptop__base"><span></span></div>
  </div>
  <div class="phone">
    <div class="phone__screen">
      {mobile.map((src, i) => (
        <Image src={src} alt="" class:list={['slide', i === 0 && 'is-active']} widths={[300, 450, 600]} sizes="(max-width: 1064px) 20vw, 200px" loading={i === 0 ? 'eager' : 'lazy'} />
      ))}
      <span class="phone__island" aria-hidden="true"></span>
    </div>
  </div>
</div>

<script>
  // Rotazione delle slide ogni 4 secondi, solo quando il mockup è visibile
  document.querySelectorAll<HTMLElement>('[data-devices]').forEach((root) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const screens = [...root.querySelectorAll('.laptop__screen, .phone__screen')].map((s) => [...s.querySelectorAll('.slide')]);
    const count = screens[0]?.length ?? 0;
    if (count < 2) return;
    let index = 0;
    let timer: number | undefined;
    const next = () => {
      index = (index + 1) % count;
      screens.forEach((slides) => slides.forEach((s, i) => s.classList.toggle('is-active', i === index)));
    };
    new IntersectionObserver(([entry]) => {
      window.clearInterval(timer);
      if (entry.isIntersecting) timer = window.setInterval(next, 4000);
    }).observe(root);
  });
</script>

<style>
  .devices {
    position: relative;
    width: 100%;
    max-width: 1000px;
    margin-inline: auto;
    aspect-ratio: 1000 / 600;
  }

  /* Computer */
  .laptop {
    position: absolute;
    top: 0;
    left: 3%;
    width: 78%;
  }
  .laptop__lid {
    padding: 1.8% 1.8% 2.6%;
    background: linear-gradient(180deg, #2a2d30, #16181a);
    border-radius: 18px 18px 6px 6px;
    box-shadow: inset 0 0 0 1.5px #3a3e42;
  }
  .laptop__screen {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 4px;
    background: #ffffff;
  }
  .laptop__base {
    position: relative;
    width: 112%;
    height: 0;
    padding-bottom: 3.6%;
    margin-left: -6%;
    background: linear-gradient(180deg, #8d9196 0%, #5d6166 40%, #2c2f32 100%);
    border-radius: 2px 2px 18px 18px / 2px 2px 60% 60%;
  }
  .laptop__base span {
    position: absolute;
    top: 0;
    left: 50%;
    width: 16%;
    height: 40%;
    transform: translateX(-50%);
    background: #4a4e52;
    border-radius: 0 0 8px 8px;
  }

  /* Telefono */
  .phone {
    position: absolute;
    right: 3%;
    bottom: 2%;
    width: 20.5%;
    padding: 1.1%;
    background: linear-gradient(160deg, #3a3e42, #15171a);
    border-radius: 17% / 8%;
    box-shadow:
      inset 0 0 0 1.5px #4a4e52,
      0 24px 48px rgba(21, 24, 26, 0.22);
  }
  .phone__screen {
    position: relative;
    aspect-ratio: 390 / 844;
    overflow: hidden;
    border-radius: 14% / 6.5%;
    background: #ffffff;
  }
  /* Barra di stato in alto: l'isola dinamica non copre il sito */
  .devices .phone__screen :global(.slide) {
    top: 5.5%;
    height: 94.5%;
  }
  .phone__island {
    position: absolute;
    top: 1.4%;
    left: 50%;
    width: 30%;
    height: 3.6%;
    transform: translateX(-50%);
    background: #0b0c0d;
    border-radius: 999px;
  }

  /* Slide: una sopra l'altra, si alternano in dissolvenza */
  .devices :global(.slide) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .devices :global(.slide.is-active) {
    opacity: 1;
  }

  @media (max-width: 600px) {
    .laptop__lid {
      border-radius: 10px 10px 4px 4px;
    }
    .laptop__screen {
      border-radius: 2px;
    }
  }
</style>
