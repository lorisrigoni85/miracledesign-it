---
/* Bandierina del paese, disegnata in SVG (le emoji delle bandiere non si vedono su tutti i sistemi). */
import type { Country } from '../data/archive';

interface Props {
  country: Country;
  /** Nome del paese, letto dai lettori di schermo e mostrato al passaggio del mouse. */
  label: string;
}
const { country, label } = Astro.props;
---
<span class="flag" role="img" aria-label={label} title={label}>
  {country === 'IT' && (
    <svg viewBox="0 0 3 3" width="16" height="16" aria-hidden="true">
      <rect width="1" height="3" fill="#009246" />
      <rect x="1" width="1" height="3" fill="#ffffff" />
      <rect x="2" width="1" height="3" fill="#ce2b37" />
    </svg>
  )}
  {country === 'CH' && (
    <svg viewBox="0 0 32 32" width="16" height="16" aria-hidden="true">
      <rect width="32" height="32" fill="#da291c" />
      <path d="M13 6h6v7h7v6h-7v7h-6v-7H6v-6h7z" fill="#ffffff" />
    </svg>
  )}
  {country === 'NP' && (
    <svg viewBox="0 0 32 32" width="16" height="16" aria-hidden="true">
      <rect width="32" height="32" fill="#dc143c" />
      <circle cx="16" cy="16" r="14.5" fill="none" stroke="#003893" stroke-width="3" />
      <path d="M11.5 8.5a4.5 4.5 0 0 0 9 0a4.5 3 0 0 1-9 0z" fill="#ffffff" />
      <circle cx="16" cy="20" r="4" fill="#ffffff" />
    </svg>
  )}
  {country === 'AM' && (
    <svg viewBox="0 0 3 3" width="16" height="16" aria-hidden="true">
      <rect width="3" height="1" fill="#d90012" />
      <rect y="1" width="3" height="1" fill="#0033a0" />
      <rect y="2" width="3" height="1" fill="#f2a800" />
    </svg>
  )}
</span>

<style>
  .flag {
    display: inline-flex;
    vertical-align: middle;
    line-height: 0;
  }
  /* Tutte inscritte in un cerchio dello stesso diametro */
  .flag svg {
    display: block;
    border-radius: 50%;
    /* Bordo sottile: separa il bianco del tricolore dal fondo chiaro */
    box-shadow: 0 0 0 1px rgba(21, 24, 26, 0.15);
  }
</style>
