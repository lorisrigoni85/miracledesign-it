---
/* Scheda di un caso studio: testo a sinistra, immagine a destra. Usata nella Home e nella pagina Lavori. */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { emphasis } from '../utils/emphasis';

interface Props {
  eyebrow: string;
  title: string;
  text: string;
  /** Righe in maiuscoletto sotto il testo (numeri o temi del caso). */
  stats: string[];
  href: string;
  linkLabel: string;
  /** Immagine fissa; senza, la parte destra prende lo slot "media" (es. un mockup animato). */
  image?: ImageMetadata;
  imageAlt?: string;
  /** h3 nella Home (sotto "Lavori in evidenza"), h2 nella pagina Lavori. */
  level?: 'h2' | 'h3';
}
const { eyebrow, title, text, stats, href, linkLabel, image, imageAlt, level = 'h3' } = Astro.props;
const Heading = level;
---
<article class="case">
  <div class="case__text">
    <p class="mono">{eyebrow}</p>
    <Heading class="case__title">{title}</Heading>
    <p class="case__body" set:html={emphasis(text)} />
    <ul class="case__stats">
      {stats.map((stat) => <li>{stat}</li>)}
    </ul>
    <a class="link" href={href}>{linkLabel} →</a>
  </div>
  <div class="case__media">
    {image ? (
      <Image src={image} alt={imageAlt ?? ''} class="case__img" widths={[600, 900, 1200]} sizes="(max-width: 760px) 100vw, 640px" />
    ) : (
      <slot name="media" />
    )}
  </div>
</article>

<style>
  .case {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px 64px;
    padding: 56px 0 64px;
    border-top: 1px solid var(--rule);
  }
  .case__text {
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .case__media {
    flex: 1.3 1 440px;
    min-width: 0;
  }
  .case__img {
    width: 100%;
    height: auto;
  }
  .case__title {
    font-size: var(--fs-h2-case);
    font-weight: 500;
    line-height: var(--lh-h2-case);
    letter-spacing: -0.025em;
  }
  .case__body {
    color: var(--ink-body);
  }
  .case__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 0.6em;
    list-style: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .case__stats li:not(:last-child)::after {
    content: ',';
  }
</style>
