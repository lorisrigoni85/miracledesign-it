---
import Logo from './Logo.astro';
import { ui, routes, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
  /** In cima alla pagina c'è una foto scura: testi chiari anche prima dello scorrimento. */
  overDark?: boolean;
}
const { lang, alternates, overDark = false } = Astro.props;
const t = ui[lang];

// Voce attiva del menu: la sezione in cui si trova la pagina corrente.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const section = (base: string) => path.startsWith(base);
const active = {
  work: section(routes.telepass[lang]),
  archive: section(routes.archive[lang]),
  about: section(routes.about[lang]),
  cv: section(routes.cv[lang]),
};
/** aria-current: "page" sulla pagina stessa, "true" dentro la sezione (es. un capitolo Telepass). */
const current = (key: keyof typeof active, base: string) =>
  active[key] ? (path === base ? 'page' : 'true') : undefined;
---
<header class:list={['header', overDark && 'header--over-dark']} data-header>
  <div class="container header__inner">
    <a href={routes.home[lang]} class="header__logo">
      <span class="visually-hidden">Miracle Design — Loris Rigoni, {t.home}</span>
      <Logo />
    </a>

    <button class="header__toggle" type="button" aria-expanded="false" aria-controls="site-menu"
      data-open={t.menuOpen} data-close={t.menuClose}>
      <span class="visually-hidden">{t.menuOpen}</span>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path class="icon-open" d="M3 7h18M3 12h18M3 17h18" />
        <path class="icon-close" d="M5 5l14 14M19 5L5 19" />
      </svg>
    </button>

    <nav id="site-menu" class="header__nav" aria-label={lang === 'it' ? 'Principale' : 'Main'}>
      <ul class="header__list">
        <li><a href={t.workAnchor} class:list={[active.work && 'is-active']} aria-current={active.work ? 'true' : undefined}>{t.nav.work}</a></li>
        <li><a href={routes.archive[lang]} class:list={[active.archive && 'is-active']} aria-current={current('archive', routes.archive[lang])}>{t.nav.archive}</a></li>
        <li><a href={routes.about[lang]} class:list={[active.about && 'is-active']} aria-current={current('about', routes.about[lang])}>{t.nav.about}</a></li>
        <li><a href={routes.cv[lang]} class:list={[active.cv && 'is-active']} aria-current={current('cv', routes.cv[lang])}>{t.nav.cv}</a></li>
        <li><a href={t.contactAnchor} class="header__contact">{t.nav.contact}</a></li>
        <li class="header__lang" aria-label={t.langLabel}>
          {lang === 'it'
            ? <><span aria-current="true">IT</span><span aria-hidden="true">/</span><a href={alternates.en} hreflang="en" lang="en">EN</a></>
            : <><a href={alternates.it} hreflang="it" lang="it">IT</a><span aria-hidden="true">/</span><span aria-current="true">EN</span></>}
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // Trasparente in cima alla pagina, scuro appena si scorre (come il sito precedente).
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const update = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  const toggle = document.querySelector<HTMLButtonElement>('.header__toggle');
  const nav = document.getElementById('site-menu');
  if (toggle && nav) {
    const label = toggle.querySelector('.visually-hidden')!;
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? toggle.dataset.close! : toggle.dataset.open!;
      document.body.classList.toggle('menu-open', open);
      header?.classList.toggle('is-open', open);
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        set(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  /* Colori dell'header: chiaro sul fondo pagina, chiaro su scuro quando si scorre */
  .header {
    --hdr-fg: var(--ink);
    --hdr-muted: var(--ink-muted);
    --hdr-bg: transparent;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 30;
    color: var(--hdr-fg);
    background: var(--hdr-bg);
    transition: background-color 200ms ease, color 200ms ease;
  }
  .header.is-scrolled {
    --hdr-fg: var(--on-dark);
    --hdr-muted: var(--on-dark-muted);
    --hdr-bg: var(--ink);
  }
  /* Sopra la foto scura dell'apertura: testi chiari, fondo ancora trasparente */
  .header--over-dark {
    --hdr-fg: var(--on-dark);
    --hdr-muted: var(--on-dark-muted);
  }
  .header :focus-visible {
    outline-color: var(--hdr-fg);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    height: var(--header-h);
  }
  .header__logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--hdr-fg);
    text-decoration: none;
    position: relative;
    z-index: 51;
  }
  .header__logo:hover {
    color: var(--hdr-fg);
    opacity: 0.8;
  }
  .header__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 32px;
    list-style: none;
    padding: 0;
    font-size: var(--fs-nav);
  }
  .header__list a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--hdr-fg);
    text-decoration: none;
  }
  .header__list a:hover {
    color: var(--hdr-fg);
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  /* Voce della pagina attiva: sottolineatura piena, più spessa di quella al passaggio del mouse */
  .header__list a.is-active {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .header__list .header__contact {
    padding: 0 18px;
    border: 1px solid var(--hdr-fg);
    border-radius: var(--radius-pill);
  }
  .header__list .header__contact:hover {
    background: var(--hdr-fg);
    color: var(--bg);
    text-decoration: none;
  }
  .header--over-dark .header__contact:hover,
  .header.is-scrolled .header__contact:hover {
    color: var(--ink);
  }
  .header__lang {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--hdr-muted);
  }
  .header__lang [aria-current] {
    color: var(--hdr-fg);
  }
  .header__lang a {
    padding-inline: 4px;
  }
  .header__toggle {
    display: none;
  }

  /* Telefono: menu a schermo intero, voci grandi, nessuna animazione */
  @media (max-width: 760px) {
    /* A menu aperto l'header torna chiaro, sopra il fondo del menu */
    .header.is-open {
      --hdr-fg: var(--ink);
      --hdr-muted: var(--ink-muted);
      --hdr-bg: var(--bg);
      transition: none;
    }
    .header__toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: var(--tap);
      height: var(--tap);
      margin-right: -10px;
      background: none;
      border: 0;
      color: var(--hdr-fg);
      cursor: pointer;
      position: relative;
      z-index: 51;
    }
    .icon-close,
    .header__toggle[aria-expanded='true'] .icon-open {
      display: none;
    }
    .header__toggle[aria-expanded='true'] .icon-close {
      display: inline;
    }
    .header__nav {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 50;
      background: var(--bg);
      padding: calc(var(--header-h) + 24px) var(--gutter) 32px;
      overflow-y: auto;
    }
    .header__toggle[aria-expanded='true'] + .header__nav {
      display: block;
    }
    .header__list {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      font-size: 32px;
      font-weight: 500;
      letter-spacing: -0.02em;
    }
    .header__list .header__contact {
      border: 0;
      padding: 0;
    }
    .header__lang {
      margin-top: 24px;
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header {
      transition: none;
    }
  }
</style>

<style is:global>
  body.menu-open {
    overflow: hidden;
  }
  /* L'header è fisso: il contenuto parte sotto di lui */
  main {
    padding-top: var(--header-h);
  }
  [id] {
    scroll-margin-top: var(--header-h);
  }
</style>
