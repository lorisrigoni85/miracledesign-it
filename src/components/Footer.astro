---
/* Piè di pagina centrato: logo, email in evidenza, social, citazione di Bonatti, note legali. */
import { getEntry } from 'astro:content';
import Logo from './Logo.astro';
import { ui, routes, cvUrl, email, linkedin, instagram, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const copy = (await getEntry('home', lang))!.data.contact;
const year = 2026;
---
<footer id={t.contactAnchor.slice(1)} class="footer">
  <div class="container footer__inner">
    <div class="footer__logo" role="img" aria-label="Miracle Design">
      <Logo width={180} />
    </div>

    <div class="footer__contact">
      <h2 class="footer__label">{t.writeMe}</h2>
      <a class="footer__email" href={`mailto:${email}`}>{email}</a>
    </div>

    <ul class="footer__social">
      <li>
        <a href={linkedin} rel="me" aria-label="LinkedIn">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3v-11Zm6.5 0h3.83v1.5h.06c.53-1 1.84-2.06 3.79-2.06 4.05 0 4.8 2.67 4.8 6.13v5.43h-4v-4.82c0-1.15-.02-2.63-1.6-2.63-1.6 0-1.85 1.25-1.85 2.55v4.9h-4v-11Z" />
          </svg>
        </a>
      </li>
      <li>
        <a href={instagram} rel="me" aria-label="Instagram">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4.2" />
            <circle cx="17.4" cy="6.6" r="0.9" fill="currentColor" stroke="none" />
          </svg>
        </a>
      </li>
      <li><a href={cvUrl[lang]} class="footer__cv">CV</a></li>
    </ul>

    <figure class="footer__quote">
      <blockquote>
        <p>“{copy.quote} <strong>{copy.quoteStrong}</strong>.”</p>
      </blockquote>
      <figcaption>{copy.quoteAuthor}</figcaption>
    </figure>

    <p class="footer__legal">
      Miracle Design · © {year} · <a href={routes.privacy[lang]}>{t.privacy}</a> ·
      <button type="button" class="footer__prefs" data-cookie-preferences>{t.cookies.preferences}</button>
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--on-dark);
  }
  .footer a {
    color: var(--on-dark);
    text-decoration: none;
  }
  .footer a:hover {
    color: var(--on-dark-muted);
  }
  .footer :focus-visible {
    outline-color: var(--on-dark);
  }
  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 56px;
    padding-top: 96px;
    padding-bottom: 32px;
    text-align: center;
  }
  .footer__logo {
    display: inline-flex;
  }

  /* Email in evidenza */
  .footer__contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .footer__label {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }
  .footer .footer__email {
    font-size: clamp(30px, 5vw, 64px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    overflow-wrap: anywhere;
  }
  .footer .footer__email:hover {
    color: var(--on-dark);
    text-decoration-thickness: 2px;
  }

  /* Citazione, in secondo piano */
  .footer__quote {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: var(--on-dark-muted);
  }
  .footer__quote blockquote {
    max-width: 640px;
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.4;
    text-wrap: balance;
  }
  .footer__quote strong {
    font-weight: 600;
    color: var(--on-dark);
  }
  .footer__quote figcaption {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .footer__social {
    display: flex;
    align-items: center;
    gap: 16px;
    list-style: none;
    padding: 0;
  }
  .footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--tap);
    min-height: var(--tap);
    color: var(--on-dark-muted);
  }
  .footer__social a:hover {
    color: var(--on-dark);
  }
  .footer__cv {
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.04em;
  }

  .footer__legal {
    width: 100%;
    padding-top: 24px;
    border-top: 1px solid var(--rule-on-dark);
    font-size: 14px;
    color: var(--on-dark-muted);
  }
  .footer__legal a {
    color: var(--on-dark-muted);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer__prefs {
    min-height: var(--tap);
    padding: 0;
    border: 0;
    background: none;
    color: var(--on-dark-muted);
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .footer__prefs:hover,
  .footer__legal a:hover {
    color: var(--on-dark);
  }
</style>
