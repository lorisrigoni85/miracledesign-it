---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { ui, linkedin, instagram, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Indirizzo della stessa pagina in ciascuna lingua (selettore e hreflang). */
  alternates: Record<Lang, string>;
  /** Dati strutturati Person, solo in Home. */
  person?: boolean;
  /** La pagina si apre con una foto scura sotto l'header: header chiaro anche in cima. */
  darkHero?: boolean;
}

const { lang, title, description, alternates, person = false, darkHero = false } = Astro.props;
const t = ui[lang];
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const abs = (path: string) => new URL(path, site).href;

const jsonLd = person
  ? {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Loris Rigoni',
      jobTitle: 'Senior Product Designer',
      url: abs(alternates[lang]),
      sameAs: [linkedin, instagram],
      address: { '@type': 'PostalAddress', addressLocality: 'Como', addressCountry: 'IT' },
    }
  : null;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="it" href={abs(alternates.it)} />
    <link rel="alternate" hreflang="en" href={abs(alternates.en)} />
    <link rel="alternate" hreflang="x-default" href={abs(alternates.it)} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#15181A" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Miracle Design" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header lang={lang} alternates={alternates} overDark={darkHero} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <CookieBanner lang={lang} />
    <script is:inline>
      // Comparsa allo scroll: i blocchi sotto la piega entrano con una dissolvenza e una leggera salita.
      // Quelli già visibili all'apertura non si toccano; senza JavaScript o con "riduci movimento" tutto resta visibile.
      (() => {
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const selector = [
          'main section:not(.hero):not([data-story])',
          'main .moment > *',
          'main .page-body > *',
          'main .archive tbody tr',
          'main .next',
        ].join(',');
        const all = [...document.querySelectorAll(selector)];
        const targets = all.filter((el) => !all.some((other) => other !== el && other.contains(el)));
        const fold = window.innerHeight;
        const io = new IntersectionObserver(
          (entries) => {
            let n = 0;
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.style.transitionDelay = `${Math.min(n++, 4) * 80}ms`;
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        for (const el of targets) {
          if (el.getBoundingClientRect().top < fold) continue;
          el.setAttribute('data-reveal', '');
          io.observe(el);
        }
        // In stampa tutto deve essere visibile
        addEventListener('beforeprint', () => targets.forEach((el) => el.classList.add('is-in')));
      })();
    </script>
  </body>
</html>
