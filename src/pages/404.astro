---
import BaseLayout from '../layouts/BaseLayout.astro';
import MountainIsland from '../components/MountainIsland.astro';
---
<BaseLayout lang="it" title="Fuori sentiero — Miracle Design" description="Pagina non trovata." alternates={{ it: '/', en: '/en/' }}>
  <div class="container notfound">
    <div class="notfound__text">
      <p class="label">404 · Fuori sentiero</p>
      <h1 class="page-title">Qui il sentiero finisce.</h1>
      <p class="page-lead">La pagina che cerchi non esiste, o ha preso un’altra strada.</p>
      <p class="mono" lang="en">Off the trail: this page doesn’t exist.</p>
      <div class="actions">
        <a class="btn btn--solid" href="/">Torna al campo base</a>
      </div>
    </div>

    <!-- Illustrazione: isola con montagne, il sentiero si interrompe davanti a una frattura -->
    <div class="notfound__art">
      <MountainIsland />
    </div>
  </div>
</BaseLayout>

<style>
  .notfound {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: 48px 64px;
    padding-top: 72px;
    padding-bottom: var(--section-y);
  }
  .notfound__text {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .notfound__art {
    width: 100%;
    max-width: 520px;
    height: auto;
    justify-self: end;
  }
  @media (max-width: 760px) {
    .notfound {
      grid-template-columns: 1fr;
      padding-top: 40px;
    }
    .notfound__art {
      order: -1;
      max-width: 320px;
      justify-self: start;
    }
  }
</style>
